{
  "name": "mailmcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted multi-account Gmail MCP server for Claude",
  "scripts": {
    "dev": "tsx watch src/dev.ts",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "synth": "cdk synth",
    "deploy": "cdk deploy",
    "diff": "cdk diff"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1147.0",
    "@aws-sdk/client-kms": "^3.1147.0",
    "@aws-sdk/client-ssm": "^3.1147.0",
    "@aws-sdk/lib-dynamodb": "^3.1147.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "hono": "^4.13.13",
    "html-to-text": "^10.0.1",
    "nodemailer": "^10.0.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hono/node-server": "^2.1.3",
    "@types/aws-lambda": "^8.10.164",
    "@types/html-to-text": "^9.0.4",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "aws-cdk": "^2.1144.0",
    "aws-cdk-lib": "^2.272.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "mailparser": "^3.9.36",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/devsandip/mailmcp.git"
  }
}
